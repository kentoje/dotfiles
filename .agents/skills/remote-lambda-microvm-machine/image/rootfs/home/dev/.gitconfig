# Dev MicroVM git config (from the remote-lambda-microvm-machine skill image). Holds no tokens:
# gitlab.com credentials come from GITLAB_TOKEN through the helper below. user.name and
# user.email are in ~/.config/git/config, written at image build from the laptop's mvm settings.
[init]
	defaultBranch = main
[credential "https://gitlab.com"]
	helper = /home/dev/.config/git/gitlab-credential.sh
[url "https://gitlab.com/"]
	insteadOf = git@gitlab.com:
[url "https://github.com/"]
	insteadOf = git@github.com:
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[push]
	autoSetupRemote = true
[fetch]
	prune = true
