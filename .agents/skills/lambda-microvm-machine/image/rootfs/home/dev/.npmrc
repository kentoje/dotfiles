# Tokens are env references, resolved by npm/pnpm at runtime from the MicroVM env secret.
registry=https://npm-proxy.fury.io/aircall-packages/
always-auth=true
@aircall-node-libraries:registry=https://npm.fury.io/aircall-packages/
@dashboard:registry=https://gitlab.com/api/v4/projects/32894131/packages/npm/
//npm.fury.io/aircall-packages/:_authToken=${GEMFURY_AUTH}
//npm-proxy.fury.io/aircall-packages/:_authToken=${GEMFURY_AUTH}
//gitlab.com/api/v4/projects/32894131/packages/npm/:_authToken=${GITLAB_TOKEN}
