{
  "name": "pi-custom-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm exec biome check . && pnpm exec tsc --noEmit && pnpm run ts:check && pnpm run check:purpose",
    "check:purpose": "bun run scripts/check-harness-module-contracts.ts",
    "format": "pnpm exec biome format --write .",
    "test": "bun test extensions lib scripts/check-harness-module-contracts.test.ts",
    "ts:check": "tsgo --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.107",
    "effect": "4.0.0-beta.107"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@google/genai",
      "msgpackr-extract",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  }
}
