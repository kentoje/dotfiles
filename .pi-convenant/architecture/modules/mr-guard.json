{
  "schema_version": 1,
  "interface_id": "mr-guard-v1",
  "owner": "mr-guard",
  "implementation_root": "src/mr-guard/",
  "test_root": "tests/mr-guard/",
  "role": "Creation decision only; consumes MR lookup, never creates an MR.",
  "dependencies": [
    "tool-protocol",
    "repository-context",
    "mr"
  ],
  "operations": {
    "check_creation": {
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1,
            "description": "Optional session-relative working path."
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "description": "Optional explicitly selected repository ID or configured host/path."
          },
          "source_branch": {
            "type": "string",
            "minLength": 1
          },
          "target_branch": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_branch",
          "target_branch",
          "title"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial",
              "blocked",
              "error",
              "cancelled",
              "indeterminate"
            ]
          },
          "context": {
            "type": "object",
            "description": "Resolved identities and target IDs, retaining known values on failure."
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "decision": {
                    "enum": [
                      "allow",
                      "reuse_existing",
                      "blocked"
                    ]
                  },
                  "existing_mrs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "iid": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_branch": {
                          "type": "string",
                          "minLength": 1
                        },
                        "target_branch": {
                          "type": "string",
                          "minLength": 1
                        },
                        "head_sha": {
                          "type": "string",
                          "minLength": 1
                        },
                        "draft": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "iid",
                        "source_branch",
                        "head_sha"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "blockers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "expected_title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "decision",
                  "existing_mrs",
                  "blockers",
                  "expected_title"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "details": {
                    "type": "object"
                  }
                },
                "required": [
                  "code",
                  "message",
                  "phase",
                  "retryable"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completed_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": [
                    "committed",
                    "unknown"
                  ]
                },
                "reference": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "phase",
                "target",
                "outcome"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "context",
          "data",
          "error",
          "warnings",
          "completed_effects"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "decision": {
                      "enum": [
                        "allow",
                        "reuse_existing",
                        "blocked"
                      ]
                    },
                    "existing_mrs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "iid": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "url": {
                            "type": "string",
                            "minLength": 1
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1
                          },
                          "source_branch": {
                            "type": "string",
                            "minLength": 1
                          },
                          "target_branch": {
                            "type": "string",
                            "minLength": 1
                          },
                          "head_sha": {
                            "type": "string",
                            "minLength": 1
                          },
                          "draft": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "iid",
                          "source_branch",
                          "head_sha"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "blockers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "expected_title": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "decision",
                    "existing_mrs",
                    "blockers",
                    "expected_title"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "effect": "read-only",
      "rules": [
        "Resolve the effective creation cwd/source/target, including supported direct-command leading cwd changes. Unparseable recognized creation syntax blocks with guidance instead of checking the wrong cwd.",
        "Lookup all open matching branch MRs completely. Zero may proceed; one returns reuse_existing; more than one blocks ambiguity. Lookup failure blocks the creation, not the rest of the coding session.",
        "Apply only explicitly configured title/release-artifact rules using branch evidence. No configured rule means no invented one.",
        "No creation occurs here. A blocked result produces one report and no follow-up agent turn."
      ]
    }
  },
  "consumes": {
    "tool-protocol": [
      "validate_boundary"
    ],
    "repository-context": [
      "resolve"
    ],
    "mr": [
      "status"
    ]
  },
  "host_capabilities": [],
  "state_ownership": [
    "Immutable invocation facts and returned evidence; no implicit global mutable cache"
  ]
}
