{
  "schema_version": 1,
  "interface_id": "jira-preflight-v1",
  "owner": "jira-preflight",
  "implementation_root": "src/jira-preflight/",
  "test_root": "tests/jira-preflight/",
  "role": "Pure duplicate decision logic over candidates supplied by Jira; never calls Jira, avoiding a cycle.",
  "dependencies": [
    "tool-protocol"
  ],
  "operations": {
    "evaluate_duplicates": {
      "input_schema": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "minLength": 1
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "issue_type": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "state": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "key",
                "summary",
                "state"
              ],
              "additionalProperties": false
            }
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "site",
          "project",
          "issue_type",
          "summary",
          "candidates",
          "complete"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial",
              "blocked",
              "error",
              "cancelled",
              "indeterminate"
            ]
          },
          "context": {
            "type": "object",
            "description": "Resolved identities and target IDs, retaining known values on failure."
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "decision": {
                    "enum": [
                      "proceed",
                      "duplicate_decision_required",
                      "blocked"
                    ]
                  },
                  "proposal_identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "matches": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "decision",
                  "proposal_identity",
                  "matches"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "details": {
                    "type": "object"
                  }
                },
                "required": [
                  "code",
                  "message",
                  "phase",
                  "retryable"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completed_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": [
                    "committed",
                    "unknown"
                  ]
                },
                "reference": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "phase",
                "target",
                "outcome"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "context",
          "data",
          "error",
          "warnings",
          "completed_effects"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "decision": {
                      "enum": [
                        "proceed",
                        "duplicate_decision_required",
                        "blocked"
                      ]
                    },
                    "proposal_identity": {
                      "type": "string",
                      "minLength": 1
                    },
                    "matches": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "decision",
                    "proposal_identity",
                    "matches"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "effect": "pure",
      "rules": [
        "Normalize Unicode/case/whitespace deterministically. Incomplete candidates block absence; decision identity binds proposal, not authorization."
      ]
    }
  },
  "consumes": {
    "tool-protocol": [
      "validate_boundary"
    ]
  },
  "host_capabilities": [],
  "state_ownership": [
    "Immutable invocation facts and returned evidence; no implicit global mutable cache"
  ]
}
