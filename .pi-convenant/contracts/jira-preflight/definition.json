{
  "schema_version": 1,
  "name": "jira-preflight",
  "kind": "preflight",
  "design_status": "specified-awaiting-implementation",
  "description": "Make duplicate issue decisions explicit for the exact selected create proposal, without local ticket-binding state.",
  "component": "jira-preflight",
  "shared_protocol": "docs/tool-protocol.md",
  "actions": [
    {
      "name": "check_creation",
      "effect": "read-only",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "minLength": 1
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "issue_type": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "project",
          "issue_type",
          "summary"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial",
              "blocked",
              "error",
              "cancelled",
              "indeterminate"
            ]
          },
          "context": {
            "type": "object",
            "description": "Resolved identities and target IDs, retaining known values on failure."
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "decision": {
                    "enum": [
                      "proceed",
                      "duplicate_decision_required",
                      "blocked"
                    ]
                  },
                  "proposal_identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exact_matches": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "summary": {
                          "type": "string"
                        },
                        "state": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1
                        },
                        "fields": {
                          "type": "object"
                        }
                      },
                      "required": [
                        "key",
                        "summary",
                        "state"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "suggestions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "summary": {
                          "type": "string"
                        },
                        "state": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1
                        },
                        "fields": {
                          "type": "object"
                        }
                      },
                      "required": [
                        "key",
                        "summary",
                        "state"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "complete": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "decision",
                  "proposal_identity",
                  "exact_matches",
                  "suggestions",
                  "complete"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "details": {
                    "type": "object"
                  }
                },
                "required": [
                  "code",
                  "message",
                  "phase",
                  "retryable"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completed_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": [
                    "committed",
                    "unknown"
                  ]
                },
                "reference": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "phase",
                "target",
                "outcome"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "context",
          "data",
          "error",
          "warnings",
          "completed_effects"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "decision": {
                      "enum": [
                        "proceed",
                        "duplicate_decision_required",
                        "blocked"
                      ]
                    },
                    "proposal_identity": {
                      "type": "string",
                      "minLength": 1
                    },
                    "exact_matches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string",
                            "minLength": 1
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "summary": {
                            "type": "string"
                          },
                          "state": {
                            "type": "string",
                            "minLength": 1
                          },
                          "url": {
                            "type": "string",
                            "minLength": 1
                          },
                          "fields": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "key",
                          "summary",
                          "state"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "suggestions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string",
                            "minLength": 1
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "summary": {
                            "type": "string"
                          },
                          "state": {
                            "type": "string",
                            "minLength": 1
                          },
                          "url": {
                            "type": "string",
                            "minLength": 1
                          },
                          "fields": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "key",
                          "summary",
                          "state"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "complete": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "decision",
                    "proposal_identity",
                    "exact_matches",
                    "suggestions",
                    "complete"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "obligations": [
        "JIRAPREFLIGHT-001",
        "JIRAPREFLIGHT-002",
        "JIRAPREFLIGHT-003",
        "JIRAPREFLIGHT-004",
        "JIRAPREFLIGHT-005"
      ],
      "ordering": [
        "resolve exact proposal",
        "search bounded pages needed for completeness",
        "normalize visible summaries",
        "match or require decision",
        "return proposal identity"
      ],
      "rules": [
        "Search within the exact selected site/project. Compare normalized summaries, including visible closed issues; display state rather than silently treating closed as absent.",
        "Exact matches require a duplicate decision, not a fabricated automatic reuse or automatic new issue. Heuristic suggestions are labeled separately.",
        "A valid previously accepted decision for this exact proposal can permit the caller to proceed; the opaque identity is correlation, not an authorization token by itself.",
        "Unfinished pagination or lookup failure blocks a no-duplicate assertion. No Jira mutation or branch-ticket state file is written by preflight."
      ],
      "failure_codes": [
        "LOOKUP_FAILED",
        "SEARCH_INCOMPLETE",
        "CONTEXT_AMBIGUOUS"
      ]
    }
  ]
}
