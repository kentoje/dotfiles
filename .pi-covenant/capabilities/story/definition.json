{
  "schema_version": 1,
  "name": "story",
  "kind": "project-cli-capability",
  "design_status": "specified-awaiting-implementation",
  "description": "Discover and render Storybook stories only when selected for that project CLI.",
  "component": "story",
  "shared_protocol": "docs/tool-protocol.md",
  "actions": [
    {
      "name": "list",
      "effect": "read-only",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial",
              "blocked",
              "error",
              "cancelled",
              "indeterminate"
            ]
          },
          "context": {
            "type": "object",
            "description": "Resolved identities and target IDs, retaining known values on failure."
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "stories": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "title": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": ["id", "title", "name"],
                      "additionalProperties": false
                    }
                  },
                  "complete": {
                    "type": "boolean"
                  }
                },
                "required": ["stories", "complete"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "details": {
                    "type": "object"
                  }
                },
                "required": ["code", "message", "phase", "retryable"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completed_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": ["committed", "unknown"]
                },
                "reference": {
                  "type": ["string", "null"]
                }
              },
              "required": ["phase", "target", "outcome"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "context",
          "data",
          "error",
          "warnings",
          "completed_effects"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "stories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "title": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": ["id", "title", "name"],
                        "additionalProperties": false
                      }
                    },
                    "complete": {
                      "type": "boolean"
                    }
                  },
                  "required": ["stories", "complete"],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "obligations": [
        "STORY-001",
        "STORY-002",
        "STORY-003",
        "STORY-004",
        "STORY-005"
      ],
      "ordering": [
        "resolve selected capability/index",
        "read and validate index",
        "apply selector",
        "return IDs"
      ],
      "rules": [
        "Read the selected project index and return stable matching IDs in deterministic ID order.",
        "No match is an empty successful list; unreachable/invalid index is an error. No server startup is implied."
      ],
      "failure_codes": [
        "CAPABILITY_NOT_SELECTED",
        "INDEX_UNAVAILABLE",
        "INDEX_INVALID"
      ]
    },
    {
      "name": "show",
      "effect": "process",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "story_id": {
            "type": "string",
            "minLength": 1
          },
          "theme": {
            "type": "string",
            "minLength": 1
          },
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8192
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8192
              }
            },
            "required": ["width", "height"],
            "additionalProperties": false
          }
        },
        "required": ["story_id"],
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial",
              "blocked",
              "error",
              "cancelled",
              "indeterminate"
            ]
          },
          "context": {
            "type": "object",
            "description": "Resolved identities and target IDs, retaining known values on failure."
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "story_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "screenshot": {
                    "type": "string",
                    "minLength": 1
                  },
                  "console_errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "story_id",
                  "url",
                  "screenshot",
                  "console_errors",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "details": {
                    "type": "object"
                  }
                },
                "required": ["code", "message", "phase", "retryable"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completed_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": ["committed", "unknown"]
                },
                "reference": {
                  "type": ["string", "null"]
                }
              },
              "required": ["phase", "target", "outcome"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "context",
          "data",
          "error",
          "warnings",
          "completed_effects"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "story_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "screenshot": {
                      "type": "string",
                      "minLength": 1
                    },
                    "console_errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "story_id",
                    "url",
                    "screenshot",
                    "console_errors",
                    "evidence"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "obligations": [
        "STORY-001",
        "STORY-002",
        "STORY-003",
        "STORY-004",
        "STORY-005"
      ],
      "ordering": [
        "resolve story/index",
        "validate render options",
        "health-check selected instance",
        "open iframe render context",
        "capture evidence",
        "close owned context"
      ],
      "rules": [
        "Validate exact story ID, declared theme and viewport before opening an owned render context.",
        "Require a usable selected Storybook instance; automatic startup is allowed only if it is part of this capability agreed project plan.",
        "Build the preview iframe route and requested globals, wait for the project-defined story-ready condition, and capture screenshot plus console observations.",
        "Close owned render contexts on success, failure or cancellation. Preserve artifacts and do not close borrowed browser sessions."
      ],
      "failure_codes": [
        "CAPABILITY_NOT_SELECTED",
        "STORY_NOT_FOUND",
        "STORY_AMBIGUOUS",
        "OPTION_UNSUPPORTED",
        "INSTANCE_UNAVAILABLE",
        "RENDER_FAILED",
        "CANCELLED"
      ]
    }
  ]
}
