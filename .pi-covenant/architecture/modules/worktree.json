  "host_capabilities": ["Managed Git and setup process execution"],
  "state_ownership": [
    "Created worktree path and setup process handles",
    "Git common-directory pi-covenant-worktrees/*.json stores comparison/setup/removal state; a sibling exclusive lock coordinates mutations."
  ],
  "implementation_binding": {
    "name": "worktree-runtime",
    "language": "typescript",
    "module": "src/worktree/module-port.ts",
    "export": "makeWorktreeModule"
  },
  "implementation_status": "implemented-module-awaiting-pi-registration",
  "typescript_adapter": {
    "constructor": "makeWorktreeModule(host: WorktreeHost)",
    "operations": "new/verify/list/rm accept the declared JSON request and optional trusted WorktreeInvocation, returning Effect<WorktreeResult<T>>.",
    "context_injection": "Composition root maps already-resolved repository context and explicit trusted setup configuration into WorktreeHost. The module does not implement discovery or import another module internals.",
    "dependency_implementations": "repository-context and tool-protocol remain draft. This slice exercises the consumer using controlled resolved host fixtures, Effect Schema validation and the existing shared result contract.",
    "setup_environment": [
      "PI_WORKTREE_PATH",
      "PI_WORKTREE_BRANCH",
      "PI_WORKTREE_BASE",
      "PI_WORKTREE_REPOSITORY"
    ],
    "configuration_source": "Explicit trusted host configuration; project root > PI_WORKTREE_ROOT > ~/.pi/worktrees, then repository namespace/task. No implicit project script discovery."
  },
  "test_pattern": "**/*.test.ts"
}
