{
  "schema_version": 1,
  "interface_id": "tool-protocol-v1",
  "owner": "tool-protocol",
  "implementation_root": "src/tool-protocol/",
  "test_root": "src/tool-protocol/",
  "role": "Shared immutable types, result constructors and boundary validation; no service or host access.",
  "dependencies": [],
  "operations": {
    "validate_boundary": {
      "input_schema": {
        "type": "object",
        "properties": {
          "schema_id": {
            "type": "string",
            "minLength": 1
          },
          "payload": {}
        },
        "required": ["schema_id", "payload"],
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial",
              "blocked",
              "error",
              "cancelled",
              "indeterminate"
            ]
          },
          "context": {
            "type": "object",
            "description": "Resolved identities and target IDs, retaining known values on failure."
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "valid": {
                    "type": "boolean"
                  },
                  "violations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["valid", "violations"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "details": {
                    "type": "object"
                  }
                },
                "required": ["code", "message", "phase", "retryable"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completed_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": ["committed", "unknown"]
                },
                "reference": {
                  "type": ["string", "null"]
                }
              },
              "required": ["phase", "target", "outcome"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "context",
          "data",
          "error",
          "warnings",
          "completed_effects"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "violations": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": ["valid", "violations"],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "effect": "pure",
      "rules": [
        "Validate against pinned schema revision; no coercion or silently stripped fields."
      ]
    }
  },
  "consumes": {},
  "host_capabilities": [],
  "state_ownership": [
    "Immutable invocation facts and returned evidence; no implicit global mutable cache"
  ],
  "test_pattern": "**/*.test.ts"
}
