{
  "schema_version": 1,
  "name": "project_cli",
  "kind": "tool",
  "design_status": "implemented-pi-extension",
  "description": "Discover repository check commands and evidence; run the selected mandatory local suite while reporting available checks separately.",
  "component": "project-cli",
  "shared_protocol": "docs/tool-protocol.md",
  "actions": [
    {
      "name": "inspect",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600000
                }
              },
              "required": ["id", "command", "args", "cwd", "timeout_ms"],
              "additionalProperties": false
            }
          },
          "discovered": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "types",
                      "lint",
                      "format",
                      "unit",
                      "dead-code",
                      "e2e",
                      "build",
                      "custom",
                      "setup"
                    ]
                  }
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "selection": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "selected"
                        }
                      },
                      "required": ["state"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "covered"
                        },
                        "by": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["state", "by"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "available"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["state", "reason"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "categories",
                "command",
                "args",
                "cwd",
                "evidence",
                "selection"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["project", "source", "checks", "discovered", "notes"],
        "additionalProperties": false
      },
      "effect": "read-only",
      "rules": [
        "Read project-checks.json or package scripts statically; do not execute checks during discovery.",
        "Inventory detected check kinds, source evidence and selected/covered/available states; only the selected mandatory local suite can receive execution credit."
      ],
      "obligations": [
        "PROJECTCLI-019",
        "PROJECTCLI-020",
        "PROJECTCLI-021",
        "PROJECTCLI-022",
        "PROJECTCLI-023",
        "PROJECTCLI-024",
        "PROJECTCLI-025",
        "PROJECTCLI-026",
        "PROJECTCLI-027",
        "PROJECTCLI-028",
        "PROJECTCLI-029"
      ],
      "ordering": [
        "resolve project",
        "read configuration",
        "return required checks"
      ],
      "failure_codes": ["PROJECT_CHECK_CONFIG", "PROJECT_CHECK_FAILED"]
    },
    {
      "name": "check",
      "input_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "string",
            "minLength": 1
          },
          "keep_going": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "outcome": {
            "enum": ["pass", "fail", "blocked", "cancelled"]
          },
          "exit_code": {
            "enum": [0, 1, 2, 130]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cwd": {
                  "type": "string"
                },
                "timeout_ms": {
                  "type": "integer"
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "timed_out",
                    "unavailable",
                    "cancelled",
                    "not_run"
                  ]
                },
                "code": {
                  "type": ["integer", "null"]
                },
                "stdout": {
                  "type": "string"
                },
                "stderr": {
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                },
                "duration_ms": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "command",
                "args",
                "cwd",
                "timeout_ms",
                "status",
                "code",
                "stdout",
                "stderr",
                "truncated",
                "duration_ms"
              ],
              "additionalProperties": false
            }
          },
          "diagnostic": {
            "type": ["string", "null"]
          },
          "discovered": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "types",
                      "lint",
                      "format",
                      "unit",
                      "dead-code",
                      "e2e",
                      "build",
                      "custom",
                      "setup"
                    ]
                  }
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "selection": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "selected"
                        }
                      },
                      "required": ["state"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "covered"
                        },
                        "by": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["state", "by"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "const": "available"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["state", "reason"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "categories",
                "command",
                "args",
                "cwd",
                "evidence",
                "selection"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keep_going": {
            "type": "boolean"
          }
        },
        "required": [
          "project",
          "outcome",
          "exit_code",
          "checks",
          "diagnostic",
          "discovered",
          "notes",
          "keep_going"
        ],
        "additionalProperties": false
      },
      "effect": "process",
      "rules": [
        "Execute checks sequentially, stopping on failure by default; optional keep_going attempts later checks without clearing failures. Cancellation and global deadline always stop dispatch.",
        "Use explicit commands, working directories and timeouts; never repair, install, ship or add checks implicitly.",
        "Inventory detected check kinds, source evidence and selected/covered/available states; only the selected mandatory local suite can receive execution credit."
      ],
      "obligations": [
        "PROJECTCLI-019",
        "PROJECTCLI-020",
        "PROJECTCLI-021",
        "PROJECTCLI-022",
        "PROJECTCLI-023",
        "PROJECTCLI-024",
        "PROJECTCLI-025",
        "PROJECTCLI-026",
        "PROJECTCLI-027",
        "PROJECTCLI-028",
        "PROJECTCLI-029",
        "PROJECTCLI-030"
      ],
      "ordering": [
        "resolve and validate complete plan",
        "run checks sequentially",
        "report every required check"
      ],
      "failure_codes": ["PROJECT_CHECK_CONFIG", "PROJECT_CHECK_FAILED"]
    }
  ]
}
