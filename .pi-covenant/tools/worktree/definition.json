{
  "schema_version": 1,
  "name": "worktree",
  "kind": "tool",
  "design_status": "implemented-pi-extension",
  "description": "Create and maintain usable task worktrees without duplicating repository setup logic or losing user work.",
  "component": "worktree",
  "shared_protocol": "docs/tool-protocol.md",
  "actions": [
    {
      "name": "new",
      "effect": "local-write",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1,
            "description": "Optional session-relative working path."
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "description": "Optional explicitly selected repository ID or configured host/path."
          },
          "task": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "base": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["task"],
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "partial",
              "blocked",
              "error",
              "cancelled",
              "indeterminate"
            ]
          },
          "context": {
            "type": "object",
            "description": "Resolved identities and target IDs, retaining known values on failure."
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "branch": {
                    "type": ["string", "null"]
                  },
                  "head_sha": {
                    "type": "string",
                    "minLength": 1
                  },
                  "readiness": {
                    "enum": [
                      "ready",
                      "setup_failed",
                      "not_configured",
                      "unavailable"
                    ]
                  },
                  "setup_completed": {
                    "type": "boolean"
                  }
                },
                "required": ["path", "branch", "head_sha", "readiness"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "details": {
                    "type": "object"
                  }
                },
                "required": ["code", "message", "phase", "retryable"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completed_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": ["committed", "unknown"]
                },
                "reference": {
                  "type": ["string", "null"]
                }
              },
              "required": ["phase", "target", "outcome"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "context",
          "data",
          "error",
          "warnings",
          "completed_effects"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "branch": {
                      "type": ["string", "null"]
                    },
                    "head_sha": {
                      "type": "string",
                      "minLength": 1
                    },
                    "readiness": {
                      "enum": [
                        "ready",
                        "setup_failed",
                        "not_configured",
                        "unavailable"
                      ]
                    },
                    "setup_completed": {
                      "type": "boolean"
                    }
                  },
                  "required": ["path", "branch", "head_sha", "readiness"],
                  "additionalProperties": false
                },
                "error": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "obligations": [
        "WORKTREE-001",
        "WORKTREE-002",
        "WORKTREE-003",
        "WORKTREE-004",
        "WORKTREE-005",
        "WORKTREE-006",
        "WORKTREE-007",
        "WORKTREE-008",
        "WORKTREE-009",
        "WORKTREE-010"
      ],
      "ordering": [
        "resolve context/base/root",
        "validate and lock target",
        "check existing registered worktree",
        "create or delegate",
        "perform configured setup",
        "read readiness",
        "return exact state"
      ],
      "rules": [
        "Resolve root and names; reject absolute paths, path separators, traversal and a destination escaping through a symlink. Validate explicit Git branch names independently.",
        "Use configured branch naming or task as branch. Resolve base from explicit base, project default, or locally known remote default; unknown base blocks rather than fetches implicitly.",
        "If the same registered path/task/branch already exists, return it without rerunning setup; conflicting paths/branches block.",
        "Delegate to the repository-owned setup mechanism and avoid running native creation twice if that mechanism creates the worktree itself. Fallback is native git worktree creation only; absent setup is reported, not fabricated.",
        "Do not copy environment files from developer home by assumption, install extra packages outside setup scope, start a universal check, or create an MR.",
        "On setup failure/cancellation after creation, return partial with exact path, branch, completed steps and setup failure; stop owned processes and keep the checkout for recovery."
      ],
      "failure_codes": [
        "UNSAFE_TASK",
        "PATH_CONFLICT",
        "BRANCH_CONFLICT",
        "BASE_UNAVAILABLE",
        "SETUP_FAILED",
        "CANCELLED"
      ]
    },
