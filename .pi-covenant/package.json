{
  "name": "pi-covenant",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check",
    "check": "tsx scripts/check.ts",
    "fix": "ultracite fix",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "fallow": "fallow dead-code",
    "fallow:report": "fallow",
    "check:quality": "ultracite check",
    "check:contracts": "tsx scripts/check-module-contracts.ts",
    "setup:covenant": "tsx scripts/setup-covenant.ts",
    "probe:worktree": "tsx scripts/probe-worktree-contracts.ts",
    "project": "tsx src/project-cli/cli.ts"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.2",
    "effect": "^4.1.2",
    "shell-quote": "1.8.3",
    "typebox": "1.3.27",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@covenant/model-checker": "file:vendor/covenant-model-checker-0.1.0.tgz",
    "@covenant/vitest": "file:vendor/covenant-vitest-0.1.0.tgz",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^24.19.2",
    "@types/shell-quote": "1.7.5",
    "ajv": "^8.20.0",
    "fallow": "^3.38.1",
    "fast-check": "^4.10.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "ultracite": "8.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "pi": {
    "extensions": [
      "./src/foundation/extension.ts"
    ]
  }
}
