shell-integration-features = "no-cursor"
bold-is-bright = true

quick-terminal-animation-duration = 0.08
quick-terminal-position = "center"
quick-terminal-size = 70%,70%

# Cmd-layer forwarding. \x01 is Ctrl-A, the prefix for both tmux and herdr.
# The follow-up key is CSI-u (ESC[<code>u), not a plain byte. herdr 0.9.4 drops a
# plain byte sent in the same write as the prefix (herdrdev/herdr#5255); typing
# the prefix yourself still works. 0.9.5 fixed that, so super+o below is a plain
# byte again. The other chords stay CSI-u until each one is checked. These chords
# are tuned to the tmux keymap, and herdr's config.toml answers the same prefix
# sequences.
keybind = super+digit_1=text:\x01\x1b[49u
keybind = super+digit_2=text:\x01\x1b[50u
keybind = super+digit_3=text:\x01\x1b[51u
keybind = super+digit_4=text:\x01\x1b[52u
keybind = super+digit_5=text:\x01\x1b[53u
keybind = super+digit_6=text:\x01\x1b[54u
keybind = super+digit_7=text:\x01\x1b[55u
keybind = super+digit_8=text:\x01\x1b[56u
keybind = super+digit_9=text:\x01\x1b[57u

keybind = super+o=text:\x01o
# Cmd+b stays a Ghostty action: quick terminal, not part of the herdr session.
keybind = super+b=toggle_quick_terminal
# Cmd+Shift+B → prefix+shift+b → herdr toggle_sidebar.
keybind = super+shift+b=text:\x01\x1b[66u

keybind = super+d=text:\x01\x1b[37u
keybind = super+shift+d=text:\x01\x1b[34u
# Cmd+S → prefix+[ then 0: copy mode, then jump to the start of the line.
# The bracket is already an escape sequence, so only the 0 needs CSI-u.
keybind = super+s=text:\x01\x5b\x1b[48u
keybind = super+f=text:\x01\x1b[122u
keybind = super+t=text:\x01\x1b[99u
keybind = super+g=text:\x01\x1b[106u
keybind = super+a=text:\x01\x1b[107u
# Cmd+p reaches the multiplexer directly: tuios binds it to its command palette.
# Uncomment to send prefix+p (fd|fzf file picker in herdr and tuios) again.
# keybind = super+p=text:\x01\x1b[112u
# Cmd+N → prefix+shift+n → herdr new_workspace. Overrides Ghostty's new_window.
keybind = super+n=text:\x01\x1b[78u

keybind = shift+enter=text:\n
